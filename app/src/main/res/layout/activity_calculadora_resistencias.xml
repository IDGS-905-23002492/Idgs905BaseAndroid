<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A0E0F5"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99CC00"
        android:padding="12dp"
        android:text="Calcular Valor de resistencias"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/imgTabla"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/resistencias"
        app:layout_constraintTop_toBottomOf="@+id/txtTitulo"/>

    <Spinner
        android:id="@+id/spBanda1"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgTabla" />

    <TextView
        android:id="@+id/txtValBanda1"
        android:layout_width="50dp"
        android:layout_height="45dp"
        android:background="#FF3333"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/spBanda1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spBanda1" />

    <Spinner
        android:id="@+id/spBanda2"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spBanda1" />

    <TextView
        android:id="@+id/txtValBanda2"
        android:layout_width="50dp"
        android:layout_height="45dp"
        android:background="#FF3333"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/spBanda2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spBanda2" />

    <Spinner
        android:id="@+id/spMultiplicador"
        android:layout_width="180dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spBanda2" />

    <TextView
        android:id="@+id/txtValMultiplicador"
        android:layout_width="50dp"
        android:layout_height="45dp"
        android:background="#D2B48C"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/spMultiplicador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/spMultiplicador" />

    <TextView
        android:id="@+id/lblTolerancia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tolerancia"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spMultiplicador" />

    <RadioGroup
        android:id="@+id/rgTolerancia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblTolerancia">
        <RadioButton
            android:id="@+id/rbOro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oro (5%)"
            android:checked="true"/>
        <RadioButton
            android:id="@+id/rbPlata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plata (10%)"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnCalcularResistencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#99CC00"
        android:text="calcular"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rgTolerancia" />

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCalcularResistencia">

        <TextView
            android:id="@+id/txtOhm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="valor ohm: 0"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/txtMaximo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="valor maximo: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>
        <TextView
            android:id="@+id/txtMinimo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="valor minimo: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>